---
import Layout from '../layouts/Layout.astro';
import SpokeTemplate from '../components/SpokeTemplate.astro';
import MultiSiteHero from '../components/mocks/MultiSiteHero.astro';
import * as page from '../i18n/spokes/multi-site';
---

<Layout
  locale="sv"
  pathSv={page.paths.sv}
  pathEn={page.paths.en}
  title={page.meta.sv.title}
  description={page.meta.sv.description}
>
  <SpokeTemplate locale="sv" content={page.sv}>
    <MultiSiteHero slot="hero-visual" locale="sv" />
  </SpokeTemplate>
</Layout>
