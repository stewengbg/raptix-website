---
import Layout from '../../../layouts/Layout.astro';
import SpokeTemplate from '../../../components/SpokeTemplate.astro';
import ReportsHero from '../../../components/mocks/ReportsHero.astro';
import ReportsArchiveMid from '../../../components/mocks/ReportsArchiveMid.astro';
import * as page from '../../../i18n/spokes/reports';
---

<Layout
  locale="en"
  pathSv={page.paths.sv}
  pathEn={page.paths.en}
  title={page.meta.en.title}
  description={page.meta.en.description}
>
  <SpokeTemplate locale="en" content={page.en}>
    <ReportsHero slot="hero-visual" locale="en" />
    <ReportsArchiveMid slot="mid-visual" locale="en" />
  </SpokeTemplate>
</Layout>
