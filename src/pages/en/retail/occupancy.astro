---
import Layout from '../../../layouts/Layout.astro';
import SpokeTemplate from '../../../components/SpokeTemplate.astro';
import OccupancyHero from '../../../components/mocks/OccupancyHero.astro';
import * as page from '../../../i18n/spokes/occupancy';
---

<Layout
  locale="en"
  pathSv={page.paths.sv}
  pathEn={page.paths.en}
  title={page.meta.en.title}
  description={page.meta.en.description}
>
  <SpokeTemplate locale="en" content={page.en}>
    <OccupancyHero slot="hero-visual" locale="en" />
  </SpokeTemplate>
</Layout>
