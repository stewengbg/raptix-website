---
import Layout from '../../../layouts/Layout.astro';
import SpokeTemplate from '../../../components/SpokeTemplate.astro';
import VisitorOverviewHero from '../../../components/mocks/VisitorOverviewHero.astro';
import InsightsHeatmapMid from '../../../components/mocks/InsightsHeatmapMid.astro';
import * as page from '../../../i18n/spokes/visitor-counting';
---

<Layout
  locale="en"
  pathSv={page.paths.sv}
  pathEn={page.paths.en}
  title={page.meta.en.title}
  description={page.meta.en.description}
>
  <SpokeTemplate locale="en" content={page.en}>
    <VisitorOverviewHero slot="hero-visual" locale="en" />
    <InsightsHeatmapMid slot="mid-visual" locale="en" />
  </SpokeTemplate>
</Layout>
