---
import Layout from '../../layouts/Layout.astro';
import SpokeTemplate from '../../components/SpokeTemplate.astro';
import TemperaturLarmHero from '../../components/mocks/TemperaturLarmHero.astro';
import * as page from '../../i18n/spokes/temperaturlarm-kyl-frys';
---

<Layout
  locale="sv"
  pathSv={page.paths.sv}
  pathEn={page.paths.en}
  title={page.meta.sv.title}
  description={page.meta.sv.description}
>
  <SpokeTemplate locale="sv" content={page.sv}>
    <TemperaturLarmHero slot="hero-visual" locale="sv" />
  </SpokeTemplate>
</Layout>
