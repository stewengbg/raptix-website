---
import Layout from '../layouts/Layout.astro';
import SpokeTemplate from '../components/SpokeTemplate.astro';
import HubHero from '../components/mocks/HubHero.astro';
import PersonraknareComparisonMid from '../components/mocks/PersonraknareComparisonMid.astro';
import * as page from '../i18n/spokes/anvand-sakerhetskameror';
---

<Layout
  locale="sv"
  pathSv={page.paths.sv}
  pathEn={page.paths.en}
  title={page.meta.sv.title}
  description={page.meta.sv.description}
>
  <SpokeTemplate locale="sv" content={page.sv}>
    <HubHero slot="hero-visual" locale="sv" />
    <PersonraknareComparisonMid slot="mid-visual" locale="sv" />
  </SpokeTemplate>
</Layout>
