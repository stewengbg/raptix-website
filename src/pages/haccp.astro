---
import Layout from '../layouts/Layout.astro';
import SpokeTemplate from '../components/SpokeTemplate.astro';
import HaccpHero from '../components/mocks/HaccpHero.astro';
import ReportsHero from '../components/mocks/ReportsHero.astro';
import * as page from '../i18n/spokes/haccp';
---

<Layout
  locale="sv"
  pathSv={page.paths.sv}
  pathEn={page.paths.en}
  title={page.meta.sv.title}
  description={page.meta.sv.description}
>
  <SpokeTemplate locale="sv" content={page.sv}>
    <HaccpHero slot="hero-visual" locale="sv" />
    <ReportsHero slot="mid-visual" locale="sv" />
  </SpokeTemplate>
</Layout>
