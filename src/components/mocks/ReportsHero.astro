---
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = {
  sv: {
    url: 'reveal.raptix.se/rapporter/haccp-vecka-18.pdf',
    title: 'HACCP-rapport · Vecka 18',
    subtitle: 'Demo Store 1 · Genererad 2026-05-05 · Period: 28 apr – 4 maj',
    badge: 'KLART FÖR EGENKONTROLL',
    headers: ['Sensor', 'Gräns', 'Status'],
    rows: [
      ['Kyl — kött', '2–6°C', 'Inom gräns', 'ok'],
      ['Kyl — mejeri', '2–6°C', 'Inom gräns', 'ok'],
      ['Frys — glass', '< -18°C', 'Inom gräns', 'ok'],
      ['Kyl — ägg', '2–6°C', '1 avvikelse (åtgärdat)', 'warn'],
      ['Rumstemp — disk', '18–22°C', 'Inom gräns', 'ok'],
    ] as const,
    footTitle: 'Sammanfattning',
    footBody: '0 öppna avvikelser · 1 åtgärdad denna vecka · 99,8% tid inom gräns',
    sendNote: 'Mejlas automatiskt varje måndag 09:00 till butikschef + kvalitetsansvarig',
  },
  en: {
    url: 'reveal.raptix.se/reports/haccp-week-18.pdf',
    title: 'HACCP Report · Week 18',
    subtitle: 'Demo Store 1 · Generated 2026-05-05 · Period: 28 Apr – 4 May',
    badge: 'READY TO FILE',
    headers: ['Sensor', 'Range', 'Status'],
    rows: [
      ['Fridge — meat', '2–6°C', 'In range', 'ok'],
      ['Fridge — dairy', '2–6°C', 'In range', 'ok'],
      ['Freezer — ice cream', '< -18°C', 'In range', 'ok'],
      ['Fridge — eggs', '2–6°C', '1 breach (resolved)', 'warn'],
      ['Ambient — counter', '18–22°C', 'In range', 'ok'],
    ] as const,
    footTitle: 'Summary',
    footBody: '0 open breaches · 1 resolved this week · 99.8% time in range',
    sendNote: 'Emailed automatically every Monday 09:00 to store manager + QA lead',
  },
}[locale];
---

<div class="browser-frame">
  <div class="browser-bar">
    <span class="dot dot-r"></span>
    <span class="dot dot-y"></span>
    <span class="dot dot-g"></span>
    <span class="ml-3 text-xs text-gray-400">{t.url}</span>
  </div>
  <div class="p-6 bg-white">
    <!-- Report header -->
    <div class="flex items-start justify-between border-b border-gray-200 pb-3">
      <div>
        <p class="font-extrabold text-gray-900 text-lg leading-tight">{t.title}</p>
        <p class="text-xs text-gray-500 mt-1">{t.subtitle}</p>
      </div>
      <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-1 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-200 shrink-0">
        {t.badge}
      </span>
    </div>

    <!-- Table -->
    <table class="w-full mt-4 text-xs">
      <thead>
        <tr class="text-left text-gray-400 uppercase tracking-wider text-[9px] font-bold">
          {t.headers.map((h) => <th class="pb-2 font-bold">{h}</th>)}
        </tr>
      </thead>
      <tbody>
        {t.rows.map(([sensor, range, status, level]) => (
          <tr class="border-t border-gray-100">
            <td class="py-2 font-semibold text-gray-700">{sensor}</td>
            <td class="py-2 text-gray-500">{range}</td>
            <td
              class:list={[
                'py-2 text-right font-semibold',
                level === 'warn' ? 'text-amber-600' : 'text-emerald-600',
              ]}
            >
              {status}
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <!-- Footer summary -->
    <div class="mt-5 rounded-lg bg-gray-50 border border-gray-100 px-3 py-2.5">
      <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500">{t.footTitle}</p>
      <p class="text-sm font-semibold text-gray-700 mt-1">{t.footBody}</p>
    </div>
  </div>
</div>

<p class="text-xs text-gray-400 text-center mt-3">{t.sendNote}</p>
