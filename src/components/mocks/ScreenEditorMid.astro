---
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = {
  sv: {
    eyebrow: 'Drag-drop-editor',
    title: 'Bygg den i din egen takt',
    body: 'Välj widgets från paletten, dra dem till canvas, sätt egenskaper i höger panel. Dela med URL + lösenord.',
    alt: 'Reveal screen dashboard editor — drag-drop layout med widget-palette och egenskapspanel',
  },
  en: {
    eyebrow: 'Drag-drop editor',
    title: 'Build it at your own pace',
    body: 'Pick widgets from the palette, drag them onto the canvas, set properties in the right panel. Share by URL + password.',
    alt: 'Reveal screen dashboard editor — drag-drop layout with widget palette and properties panel',
  },
}[locale];
---

<div class="text-center mb-6">
  <p class="text-xs font-bold uppercase tracking-widest text-blue-700">{t.eyebrow}</p>
  <h3 class="mt-1.5 text-2xl font-extrabold tracking-tight">{t.title}</h3>
  <p class="mt-2 text-sm text-gray-600">{t.body}</p>
</div>

<div class="browser-frame">
  <div class="browser-bar">
    <span class="dot dot-r"></span>
    <span class="dot dot-y"></span>
    <span class="dot dot-g"></span>
  </div>
  <img
    src="/screenshots/screen-editor.png"
    alt={t.alt}
    width="1600"
    height="1100"
    loading="lazy"
    decoding="async"
    class="w-full h-auto block"
  />
</div>
