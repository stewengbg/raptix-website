---
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = {
  sv: {
    eyebrow: 'Rapport-arkivet',
    title: 'Schemalagda, mottagna, alltid sökbara',
    body: 'Vecko- och månadsrapporter levereras enligt schema. Alla genererade rapporter arkiveras i appen så du kan gå tillbaka när som helst — inga gamla PDF:er som försvinner i mejlboxen.',
    alt: 'Reveal Reports-vyn — schemalagda rapporter, nyligen levererade, samt formulär för att skapa ny rapport',
  },
  en: {
    eyebrow: 'The report archive',
    title: 'Scheduled, delivered, always searchable',
    body: 'Weekly and monthly reports go out on schedule. Every generated report is archived in the app so you can come back anytime — no old PDFs lost in someone\'s inbox.',
    alt: 'Reveal Reports view — scheduled reports, recently delivered, plus the form to schedule a new one',
  },
}[locale];
---

<div class="text-center mb-6">
  <p class="text-xs font-bold uppercase tracking-widest text-blue-700">{t.eyebrow}</p>
  <h3 class="mt-1.5 text-2xl font-extrabold tracking-tight">{t.title}</h3>
  <p class="mt-2 text-sm text-gray-600">{t.body}</p>
</div>

<div class="browser-frame">
  <div class="browser-bar">
    <span class="dot dot-r"></span>
    <span class="dot dot-y"></span>
    <span class="dot dot-g"></span>
  </div>
  <img
    src="/screenshots/reports-pdf.png"
    alt={t.alt}
    width="1440"
    height="1500"
    loading="lazy"
    decoding="async"
    class="w-full h-auto block"
  />
</div>
