---
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = {
  sv: {
    url: 'reveal.raptix.se/overview',
    visitorsLabel: 'Besökare idag',
    inStoreLabel: 'I butik',
    queueLabel: 'Kassakö',
    alertLabel: 'Larm sedan igår',
    queueStatus: 'över gräns',
    chartLabel: 'Idag · per timme',
    caption: 'En instrumentpanel. Sex sätt att skära datan.',
  },
  en: {
    url: 'reveal.raptix.se/overview',
    visitorsLabel: 'Visitors today',
    inStoreLabel: 'In store',
    queueLabel: 'Checkout queue',
    alertLabel: 'Alerts since yesterday',
    queueStatus: 'over limit',
    chartLabel: 'Today · hourly',
    caption: 'One dashboard. Six ways to slice the data.',
  },
}[locale];
---

<div class="browser-frame">
  <div class="browser-bar">
    <span class="dot dot-r"></span>
    <span class="dot dot-y"></span>
    <span class="dot dot-g"></span>
    <span class="ml-3 text-xs text-gray-400">{t.url}</span>
  </div>
  <div class="p-5 md:p-6 bg-gradient-to-b from-white to-gray-50 grid grid-cols-4 gap-3 text-xs">
    <!-- KPI strip: 4 cards -->
    <div class="bg-white border border-gray-200 rounded-lg px-3 py-2.5">
      <p class="text-[9px] tracking-widest uppercase text-gray-500 font-bold">{t.visitorsLabel}</p>
      <p class="text-[22px] font-extrabold leading-none mt-1">
        1 738 <span class="text-xs text-emerald-600 font-semibold align-middle">+4%</span>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-3 py-2.5">
      <p class="text-[9px] tracking-widest uppercase text-gray-500 font-bold">{t.inStoreLabel}</p>
      <p class="text-[22px] font-extrabold leading-none mt-1">9</p>
    </div>
    <div class="bg-white border border-red-200 rounded-lg px-3 py-2.5 bg-red-50">
      <p class="text-[9px] tracking-widest uppercase text-red-700 font-bold">{t.queueLabel}</p>
      <p class="text-[22px] font-extrabold leading-none mt-1 text-red-700">
        7 <span class="text-[9px] font-semibold align-middle">{t.queueStatus}</span>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-3 py-2.5">
      <p class="text-[9px] tracking-widest uppercase text-gray-500 font-bold">{t.alertLabel}</p>
      <p class="text-[22px] font-extrabold leading-none mt-1">3</p>
    </div>

    <!-- Bar chart -->
    <div class="col-span-4 bg-white border border-gray-200 rounded-lg px-3 py-2.5">
      <p class="text-[9px] tracking-widest uppercase text-gray-500 font-bold mb-1.5">{t.chartLabel}</p>
      <div class="flex items-end gap-1 h-14">
        {[24, 36, 48, 55, 62, 68, 74, 86, 92, 100, 78, 60, 40, 22].map((h, i) => (
          <div
            class:list={[
              'flex-1 rounded-t',
              i === 9 ? 'bg-indigo-700' : i > 9 ? 'bg-indigo-200/60' : 'bg-indigo-300',
            ]}
            style={`height: ${h}%`}
          ></div>
        ))}
      </div>
    </div>
  </div>
</div>

<p class="text-xs text-gray-400 text-center mt-3">{t.caption}</p>
