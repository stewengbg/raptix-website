---
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = {
  sv: {
    eyebrow: 'Lösningar',
    title: 'Tre vägar in i Reveal',
    subtitle: 'Välj utgångspunkten som matchar din roll. Du kommer åt allt oavsett — det här är bara den första vyn.',
    cards: [
      {
        title: 'För din butik',
        body: 'Besökarstatistik, kö, beläggning, hyllaktivitet, in-store skärmar och rapporter — sex sidor som täcker hela butiksdriften.',
        href: '/butik/',
        cta: 'Utforska butiksfunktioner',
        icon: '🏬',
      },
      {
        title: 'HACCP & egenkontroll',
        body: 'Automatisk 24/7-temperaturövervakning, audit-trail och PDF-rapport varje måndag. Designad för livsmedelsverkets inspektion.',
        href: '/haccp/',
        cta: 'Läs om HACCP-lösningen',
        icon: '🧊',
      },
      {
        title: 'Flera butiker / kedjor',
        body: 'Multi-butiksvy med live KPI:er, central efterlevnad och rollbaserad åtkomst. För distriktschefer och ops-direktörer.',
        href: '/kedjor/',
        cta: 'Se kedjelösningen',
        icon: '🌐',
      },
    ],
  },
  en: {
    eyebrow: 'Solutions',
    title: 'Three ways into Reveal',
    subtitle: "Pick the entry point that matches your role. You get access to everything either way — this is just the starting view.",
    cards: [
      {
        title: 'For your store',
        body: 'Visitor analytics, queue, occupancy, aisle traffic, in-store screens and reports — six pages covering the full store operation.',
        href: '/en/retail/',
        cta: 'Explore store features',
        icon: '🏬',
      },
      {
        title: 'HACCP & food safety',
        body: 'Automatic 24/7 temperature monitoring, audit trail and a PDF report every Monday. Designed for food-safety inspection.',
        href: '/en/haccp/',
        cta: 'Read about the HACCP solution',
        icon: '🧊',
      },
      {
        title: 'Multi-site & chains',
        body: 'Multi-site fleet view with live KPIs, central compliance and role-based access. For district managers and ops directors.',
        href: '/en/multi-site/',
        cta: 'See the chain solution',
        icon: '🌐',
      },
    ],
  },
}[locale];
---

<section id="solutions" class="bg-white border-y border-gray-100">
  <div class="max-w-6xl mx-auto px-6 py-20">
    <div class="text-center mb-12">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-700">{t.eyebrow}</p>
      <h2 class="mt-2 text-3xl md:text-4xl font-extrabold tracking-tight">{t.title}</h2>
      <p class="mt-3 text-gray-600 max-w-2xl mx-auto">{t.subtitle}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {t.cards.map((card) => (
        <a
          href={card.href}
          class="block rounded-xl bg-white border border-gray-100 hover:border-blue-300 hover:shadow-md hover:-translate-y-0.5 p-6 transition group"
        >
          <div class="feature-icon">{card.icon}</div>
          <h3 class="mt-4 text-lg font-bold text-gray-900">{card.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{card.body}</p>
          <p class="mt-4 text-sm font-semibold text-blue-600 group-hover:text-blue-700">{card.cta} →</p>
        </a>
      ))}
    </div>
  </div>
</section>
