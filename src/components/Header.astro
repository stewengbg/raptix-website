---
import type { Locale } from '../i18n';
import { t, SIGNIN_URL, SIGNUP_URL } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  /** Equivalent page path in the other locale, for the language switcher */
  altPath?: string;
}

const { locale, altPath } = Astro.props;
const tr = t(locale);
const home = locale === 'sv' ? '/' : '/en/';
const computedAltPath = altPath ?? (locale === 'sv' ? '/en/' : '/');

// Solutions dropdown — Tier 1 + Tier 2 hub pages
const solutionsLinks =
  locale === 'sv'
    ? [
        { label: 'För din butik', href: '/butik/' },
        { label: 'HACCP & egenkontroll', href: '/haccp/', soon: true },
        { label: 'Flera butiker / kedjor', href: '/kedjor/', soon: true },
      ]
    : [
        { label: 'For your store', href: '/en/retail/' },
        { label: 'HACCP & food safety', href: '/en/haccp/', soon: true },
        { label: 'Multi-site & chains', href: '/en/multi-site/', soon: true },
      ];

const solutionsLabel = locale === 'sv' ? 'Lösningar' : 'Solutions';
const homeRefersFeatures = locale === 'sv' ? '/#features' : '/en/#features';
const homeRefersPricing = locale === 'sv' ? '/#pricing' : '/en/#pricing';
const homeRefersPartners = locale === 'sv' ? '/#partners' : '/en/#partners';
---

<header class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-8">
      <a href={home} class="text-2xl font-black tracking-tighter brand-text">Reveal</a>
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <div class="relative group">
          <button
            type="button"
            class="text-gray-600 hover:text-gray-900 flex items-center gap-1 py-2"
          >
            {solutionsLabel}
            <span class="text-xs">▾</span>
          </button>
          <div
            class="absolute left-0 top-full pt-1 hidden group-hover:block group-focus-within:block"
          >
            <div class="bg-white border border-gray-100 rounded-lg shadow-lg py-2 min-w-[14rem]">
              {solutionsLinks.map((link) => (
                <a
                  href={link.soon ? undefined : link.href}
                  class:list={[
                    'flex items-center justify-between px-4 py-2 text-sm transition',
                    link.soon
                      ? 'text-gray-400 cursor-not-allowed'
                      : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900',
                  ]}
                >
                  <span>{link.label}</span>
                  {link.soon && (
                    <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-gray-100 text-gray-500">
                      {locale === 'sv' ? 'Snart' : 'Soon'}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </div>
        </div>
        <a href={homeRefersFeatures} class="text-gray-600 hover:text-gray-900">{tr.nav.features}</a>
        <a href={homeRefersPricing} class="text-gray-600 hover:text-gray-900">{tr.nav.pricing}</a>
        <a href={homeRefersPartners} class="text-gray-600 hover:text-gray-900">{tr.nav.partners}</a>
      </nav>
    </div>
    <div class="flex items-center gap-3">
      <LanguageSwitcher locale={locale} altPath={computedAltPath} />
      <a href={SIGNIN_URL} class="hidden sm:block text-sm font-medium text-gray-600 hover:text-gray-900">
        {tr.nav.signin}
      </a>
      <a
        href={SIGNUP_URL}
        class="text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition"
      >
        {tr.nav.cta}
      </a>
    </div>
  </div>
</header>
