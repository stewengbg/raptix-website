---
import type { Locale } from '../i18n';
import { t, SIGNIN_URL, SIGNUP_URL } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const home = locale === 'sv' ? '/' : '/en/';
---

<header class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-10">
      <a href={home} class="text-2xl font-black tracking-tighter brand-text">Reveal</a>
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a href="#how" class="text-gray-600 hover:text-gray-900">{tr.nav.how}</a>
        <a href="#features" class="text-gray-600 hover:text-gray-900">{tr.nav.features}</a>
        <a href="#partners" class="text-gray-600 hover:text-gray-900">{tr.nav.partners}</a>
        <a href="#pricing" class="text-gray-600 hover:text-gray-900">{tr.nav.pricing}</a>
      </nav>
    </div>
    <div class="flex items-center gap-3">
      <LanguageSwitcher locale={locale} />
      <a href={SIGNIN_URL} class="hidden sm:block text-sm font-medium text-gray-600 hover:text-gray-900">
        {tr.nav.signin}
      </a>
      <a
        href={SIGNUP_URL}
        class="text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition"
      >
        {tr.nav.cta}
      </a>
    </div>
  </div>
</header>
