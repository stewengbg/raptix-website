---
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Path to the equivalent page in the other locale (e.g. '/en/retail/reports') */
  altPath: string;
}

const { locale, altPath } = Astro.props;
const otherLocale: Locale = locale === 'sv' ? 'en' : 'sv';
const otherLabel = otherLocale === 'sv' ? 'SV' : 'EN';
const currentLabel = locale === 'sv' ? 'SV' : 'EN';
---

<div class="inline-flex items-center text-xs font-semibold rounded-full border border-gray-200 overflow-hidden">
  <span class="px-2.5 py-1 bg-gray-900 text-white">{currentLabel}</span>
  <a
    href={altPath}
    data-lang-switch
    class="px-2.5 py-1 text-gray-500 hover:text-gray-900 hover:bg-gray-50 transition"
    aria-label={`Switch to ${otherLabel}`}
    hreflang={otherLocale}
  >
    {otherLabel}
  </a>
</div>

<script>
  // Preserve hash fragment when switching languages so jumping from /en/#pricing
  // lands you on /#pricing rather than the top of the page.
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (window.location.hash) {
        e.preventDefault();
        window.location.href = a.getAttribute('href')! + window.location.hash;
      }
    });
  });
</script>
