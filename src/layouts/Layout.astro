---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  /** Path within the SV site (e.g. '/butik/rapporter'). Defaults to '/'. */
  pathSv?: string;
  /** Path within the EN site (e.g. '/en/retail/reports'). Defaults to '/en/'. */
  pathEn?: string;
  /** Override default title (otherwise uses locale meta.title) */
  title?: string;
  /** Override default description */
  description?: string;
}

const {
  locale,
  pathSv = '/',
  pathEn = '/en/',
  title: titleOverride,
  description: descriptionOverride,
} = Astro.props;
const tr = t(locale);

const siteUrl = 'https://www.raptix.se';
const currentPath = locale === 'sv' ? pathSv : pathEn;
const canonical = `${siteUrl}${currentPath}`;
const ogImage = `${siteUrl}/dashboard.png`;
const ogLocale = locale === 'sv' ? 'sv_SE' : 'en_GB';
const altLocale: Locale = locale === 'sv' ? 'en' : 'sv';
const ogAltLocale = altLocale === 'sv' ? 'sv_SE' : 'en_GB';

const title = titleOverride ?? tr.meta.title;
const description = descriptionOverride ?? tr.meta.description;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Raptix AB',
  url: siteUrl,
  logo: `${siteUrl}/raptix-favicon.png`,
  email: 'hello@raptix.se',
  sameAs: ['https://raptix.se'],
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Reveal',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Retail Analytics',
  operatingSystem: 'Web',
  description: tr.meta.description,
  url: `${siteUrl}${locale === 'sv' ? '/' : '/en/'}`,
  image: ogImage,
  publisher: {
    '@type': 'Organization',
    name: 'Raptix AB',
    url: siteUrl,
  },
  offers: {
    '@type': 'Offer',
    price: '50',
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '50',
      priceCurrency: 'USD',
      unitText: 'MONTH',
    },
    availability: 'https://schema.org/InStock',
  },
};
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2563eb" />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sv" href={`${siteUrl}${pathSv}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${pathEn}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${pathSv}`} />

    <link rel="icon" type="image/png" href="/raptix-favicon.png" />
    <link rel="apple-touch-icon" href="/raptix-favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Reveal — Raptix AB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAltLocale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <Header locale={locale} altPath={locale === 'sv' ? pathEn : pathSv} />
    <slot />
    <Footer locale={locale} />
    <style is:global>
      :root {
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      }
      .brand-text {
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .glow {
        background: radial-gradient(60% 60% at 50% 0%, rgba(37, 99, 235, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
      }
      .browser-frame {
        border-radius: 12px;
        background: white;
        box-shadow:
          0 30px 60px -20px rgba(15, 23, 42, 0.25),
          0 18px 36px -18px rgba(15, 23, 42, 0.15);
        border: 1px solid #e5e7eb;
        overflow: hidden;
      }
      .browser-bar {
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 10px 14px;
      }
      .dot {
        width: 10px;
        height: 10px;
        border-radius: 9999px;
      }
      .dot-r { background: #f87171; }
      .dot-y { background: #fbbf24; }
      .dot-g { background: #34d399; }
      .pill-soft {
        background: #eef2ff;
        color: #3730a3;
        border: 1px solid #c7d2fe;
      }
      .step-num {
        width: 32px;
        height: 32px;
        border-radius: 9999px;
        background: #4338ca;
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
      }
      .feature-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #eef2ff;
        color: #4338ca;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
      }
    </style>
  </body>
</html>
